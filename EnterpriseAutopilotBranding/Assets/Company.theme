; Replace the images in Assets while keeping the deployed destination paths in Config.xml.
[Theme]
DisplayName=Your Company

[Control Panel\Desktop]
Wallpaper=%SystemRoot%\Web\Wallpaper\Company\CompanyWallpaper.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%ResourceDir%\Themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0

[MasterThemeSelector]
MTSM=DABJDKT

