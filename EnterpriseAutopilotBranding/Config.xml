<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="Config.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<EnterpriseAutopilotBranding SchemaVersion="2" PackageVersion="4.1.0">
  <Metadata
    OrganizationName="Your Company"
    UpstreamProject="mtniehaus/AutopilotBranding"
    UpstreamBaseVersion="3.3.1" />

  <!-- Windows 11 22H2 (build 22621) or later by default. -->
  <Execution MinimumSupportedBuild="22621" />

  <Branding Enabled="true">
    <!-- Replace the sample images before production deployment. -->
    <Wallpaper
      Enabled="true"
      Source="Assets\CompanyWallpaper.jpg"
      Destination="%SystemRoot%\Web\Wallpaper\Company\CompanyWallpaper.jpg" />
    <LockScreen
      Enabled="true"
      Source="Assets\CompanyLockScreen.jpg"
      Destination="%SystemRoot%\Web\Wallpaper\Company\CompanyLockScreen.jpg" />
    <Theme
      Enabled="true"
      Source="Assets\Company.theme"
      Destination="%SystemRoot%\Resources\Themes\Company.theme" />
    <OemLogo
      Enabled="true"
      Source="Assets\CompanyLogo.bmp"
      Destination="%SystemRoot%\System32\oobe\info\CompanyLogo.bmp" />

    <!-- Prefer the Intune Start/Taskbar CSP examples in PolicyExamples. This local taskbar
         option remains available for environments that specifically require it at first sign-in. -->
    <TaskbarLayout
      Enabled="false"
      Source="Assets\TaskbarLayoutModification.xml"
      Destination="%SystemRoot%\OEM\TaskbarLayoutModification.xml" />

    <!-- Disabled because Start2.bin/settings.dat are undocumented and build-sensitive.
         If used, provide files exported and tested on every build in the configured range. -->
    <LegacyStartLayout
      Enabled="false"
      MinimumBuild="22621"
      MaximumBuild="26100"
      Start2Source="Assets\Start2.bin"
      SettingsSource="Assets\settings.dat"
      Start2Destination="%SystemDrive%\Users\Default\AppData\Local\Packages\Microsoft.Windows.StartMenuExperienceHost_cw5n1h2txyewy\LocalState\Start2.bin"
      SettingsDestination="%SystemDrive%\Users\Default\AppData\Local\Packages\Microsoft.Windows.StartMenuExperienceHost_cw5n1h2txyewy\Settings\settings.dat" />

    <OemInformation
      Enabled="true"
      Manufacturer="Your Company"
      Model="Managed Windows Device"
      SupportPhone=""
      SupportHours=""
      SupportURL="https://support.example.com" />

    <!-- These values are applied only to C:\Users\Default\NTUSER.DAT. Users who already
         have profiles are not modified. Set Enabled=false on any value managed by Intune. -->
    <DefaultUserRegistry>
      <Value Enabled="true" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" Name="StartShownOnUpgrade" Type="DWord" Data="1" />
      <Value Enabled="true" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" Name="TaskbarAl" Type="DWord" Data="0" />
      <Value Enabled="true" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" Name="TaskbarDa" Type="DWord" Data="0" />
      <Value Enabled="true" Key="Software\Policies\Microsoft\Windows\Explorer" Name="HideRecommendedSection" Type="DWord" Data="1" />
      <Value Enabled="true" Key="Software\Policies\Microsoft\Windows\Explorer" Name="NoPinningStoreToTaskbar" Type="DWord" Data="1" />
      <Value Enabled="true" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\HideDesktopIcons\NewStartPanel" Name="{2cc5ca98-6485-489a-920e-b3e88a6ccce3}" Type="DWord" Data="1" />
      <Value Enabled="true" Key="Software\Policies\Microsoft\Windows\CloudContent" Name="DisableSpotlightCollectionOnDesktop" Type="DWord" Data="1" />
      <Value Enabled="false" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoInstalledPWAs" Name="CopilotPWAPreinstallCompleted" Type="DWord" Data="1" />
      <Value Enabled="false" Key="Software\Classes\CLSID\{018D5C66-4533-4307-9B53-224DE2ED1FE6}" Name="System.IsPinnedToNameSpaceTree" Type="DWord" Data="0" />
    </DefaultUserRegistry>

    <!-- Machine values should be removed here when the same setting is managed by Intune. -->
    <MachineRegistry>
      <Value Enabled="true" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer" Name="DisableEdgeDesktopShortcutCreation" Type="DWord" Data="1" />
      <Value Enabled="true" Key="SOFTWARE\Policies\Microsoft\EdgeUpdate" Name="CreateDesktopShortcutDefault" Type="DWord" Data="0" />
      <Value Enabled="true" Key="SOFTWARE\Policies\Microsoft\EdgeUpdate" Name="RemoveDesktopShortcutDefault" Type="DWord" Data="2" />
      <Value Enabled="true" Key="SOFTWARE\Policies\Microsoft\Windows\CloudContent" Name="DisableWindowsConsumerFeatures" Type="DWord" Data="1" />
      <Value Enabled="true" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" Name="EnableFirstLogonAnimation" Type="DWord" Data="0" />
      <Value Enabled="true" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" Name="DelayedDesktopSwitchTimeout" Type="DWord" Data="0" />
      <Value Enabled="true" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" Name="DisablePrivacyExperience" Type="DWord" Data="1" />
      <Value Enabled="true" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" Name="DisableVoice" Type="DWord" Data="1" />
      <Value Enabled="true" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" Name="PrivacyConsentStatus" Type="DWord" Data="1" />
      <Value Enabled="true" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" Name="ProtectYourPC" Type="DWord" Data="3" />
      <Value Enabled="false" Key="SOFTWARE\Policies\Microsoft\Dsh" Name="AllowNewsAndInterests" Type="DWord" Data="0" />
      <Value Enabled="false" Key="SOFTWARE\Policies\Microsoft\Dsh" Name="DisableWidgetsBoard" Type="DWord" Data="1" />
    </MachineRegistry>
  </Branding>

  <OsConfiguration>
    <!-- Modes: Unchanged, Explicit, Automatic. Explicit also requires Id="Eastern Standard Time". -->
    <TimeZone Mode="Automatic" Id="" />

    <DefaultAppAssociations Enabled="false" Source="Assets\DefaultAppAssociations.xml" />

    <!-- Keep servicing separate from branding when possible. This section is disabled by default. -->
    <WindowsFeatures Enabled="false" TemporarilyBypassWsus="false">
      <DisableOptionalFeatures>
        <Feature Enabled="false" Name="WorkFolders-Client" />
        <Feature Enabled="false" Name="Recall" />
      </DisableOptionalFeatures>
      <RemoveCapabilities>
        <Capability Enabled="false" Name="StepsRecorder" />
      </RemoveCapabilities>
      <AddCapabilities>
        <Capability Enabled="false" Name="NetFX3~~~~" />
      </AddCapabilities>
    </WindowsFeatures>
  </OsConfiguration>

  <!-- Debloat is deliberately allow-list-driven: only a matching entry is considered for removal.
       Change Mode to Audit for a no-change inventory pass. MSI products and applications with a
       registered QuietUninstallString are removed; unknown interactive uninstallers are skipped. -->
  <Debloat
    Enabled="true"
    Mode="Audit"
    RunDuringDevicePhase="true"
    RunAtFirstLogon="true"
    RemoveProvisionedPackages="true"
    RemoveInstalledPackages="true"
    RemoveClassicApplications="true"
    RemovePublicDesktopShortcuts="true"
    ClassicUninstallTimeoutSeconds="600"
    ClassicOverallTimeoutSeconds="1800"
    FailOnError="false">

    <PreserveAppxPackages>
      <Package Enabled="true" NamePattern="Microsoft.WindowsStore*" />
      <Package Enabled="true" NamePattern="Microsoft.StorePurchaseApp*" />
      <Package Enabled="true" NamePattern="Microsoft.DesktopAppInstaller*" />
      <Package Enabled="true" NamePattern="Microsoft.CompanyPortal*" />
      <Package Enabled="true" NamePattern="MSTeams*" />
      <Package Enabled="true" NamePattern="Microsoft.SecHealthUI*" />
      <Package Enabled="true" NamePattern="Microsoft.AAD.BrokerPlugin*" />
      <Package Enabled="true" NamePattern="Microsoft.Windows.ShellExperienceHost*" />
      <Package Enabled="true" NamePattern="Microsoft.Windows.StartMenuExperienceHost*" />
      <Package Enabled="true" NamePattern="Microsoft.WindowsNotepad*" />
      <Package Enabled="true" NamePattern="Microsoft.WindowsCalculator*" />
      <Package Enabled="true" NamePattern="Microsoft.Windows.Photos*" />
      <Package Enabled="true" NamePattern="Microsoft.Paint*" />
      <Package Enabled="true" NamePattern="Microsoft.ScreenSketch*" />
      <Package Enabled="true" NamePattern="Microsoft.WindowsTerminal*" />
      <Package Enabled="true" NamePattern="MicrosoftCorporationII.QuickAssist*" />
      <Package Enabled="true" NamePattern="DellInc.DellPowerManager*" />
      <Package Enabled="true" NamePattern="DellInc.DellCommandUpdate*" />
      <Package Enabled="true" NamePattern="DellInc.DellCommandUpdateforWindowsUniversal*" />
    </PreserveAppxPackages>

    <AppxPackages>
      <!-- Dell consumer and home-support applications. -->
      <Package Enabled="true" NamePattern="DellInc.DellSupportAssistforPCs*" />
      <Package Enabled="true" NamePattern="DellInc.MyDell*" />
      <Package Enabled="true" NamePattern="DellInc.DellOptimizer*" />
      <Package Enabled="true" NamePattern="DellInc.DellDigitalDelivery*" />
      <Package Enabled="true" NamePattern="DellInc.DellPair*" />
      <Package Enabled="true" NamePattern="DellInc.DellCustomerConnect*" />
      <Package Enabled="true" NamePattern="DellInc.DellMobileConnect*" />
      <Package Enabled="true" NamePattern="DellInc.DellCinemaColor*" />

      <!-- Microsoft consumer applications; core management, Store, security and utility apps are preserved. -->
      <Package Enabled="true" NamePattern="Clipchamp.Clipchamp*" />
      <Package Enabled="true" NamePattern="Microsoft.BingNews*" />
      <Package Enabled="true" NamePattern="Microsoft.BingWeather*" />
      <Package Enabled="true" NamePattern="Microsoft.Getstarted*" />
      <Package Enabled="true" NamePattern="Microsoft.MicrosoftSolitaireCollection*" />
      <Package Enabled="true" NamePattern="Microsoft.People*" />
      <Package Enabled="true" NamePattern="Microsoft.WindowsFeedbackHub*" />
      <Package Enabled="true" NamePattern="Microsoft.YourPhone*" />
      <Package Enabled="true" NamePattern="Microsoft.WindowsMaps*" />
      <Package Enabled="true" NamePattern="Microsoft.ZuneMusic*" />
      <Package Enabled="true" NamePattern="Microsoft.ZuneVideo*" />
      <Package Enabled="true" NamePattern="Microsoft.Xbox*" />
      <Package Enabled="true" NamePattern="Microsoft.GamingApp*" />
      <Package Enabled="true" NamePattern="Microsoft.549981C3F5F10*" />
      <Package Enabled="true" NamePattern="MicrosoftCorporationII.MicrosoftFamily*" />
      <Package Enabled="true" NamePattern="MicrosoftTeams*" />

      <!-- Common OEM promotional applications. -->
      <Package Enabled="true" NamePattern="*AmazonVideo*" />
      <Package Enabled="true" NamePattern="*TikTok*" />
      <Package Enabled="true" NamePattern="*Disney*" />
      <Package Enabled="true" NamePattern="*Facebook*" />
      <Package Enabled="true" NamePattern="*Instagram*" />
      <Package Enabled="true" NamePattern="*Spotify*" />
      <Package Enabled="true" NamePattern="king.com.*" />
      <Package Enabled="true" NamePattern="WildTangentGames.*" />
      <Package Enabled="true" NamePattern="DropboxInc.Dropbox*" />
      <Package Enabled="true" NamePattern="*Booking.com*" />

      <!-- Review these role-dependent apps before enabling. -->
      <Package Enabled="false" NamePattern="Microsoft.OutlookForWindows*" />
      <Package Enabled="false" NamePattern="Microsoft.Windows.DevHome*" />
      <Package Enabled="false" NamePattern="Microsoft.PowerAutomateDesktop*" />
    </AppxPackages>

    <!-- Preservation rules are evaluated before removal rules. Dell Command Update and
         enterprise/security/peripheral utilities remain installed by default. -->
    <PreserveClassicApplications>
      <Application Enabled="true" DisplayNamePattern="Dell Command*Update*" />
      <Application Enabled="true" DisplayNamePattern="Dell Command*Configure*" />
      <Application Enabled="true" DisplayNamePattern="Dell Command*Monitor*" />
      <Application Enabled="true" DisplayNamePattern="Dell Command*Power Manager*" />
      <Application Enabled="true" DisplayNamePattern="Dell Power Manager*" />
      <Application Enabled="true" DisplayNamePattern="Dell Trusted Device*" />
      <Application Enabled="true" DisplayNamePattern="Dell Display Manager*" />
      <Application Enabled="true" DisplayNamePattern="Dell Peripheral Manager*" />
      <Application Enabled="true" DisplayNamePattern="Dell Dock*" />
      <Application Enabled="true" DisplayNamePattern="Dell Thunderbolt*" />
      <Application Enabled="true" DisplayNamePattern="Dell Instrumentation*" />
      <Application Enabled="true" DisplayNamePattern="Dell Core Services*" />
      <Application Enabled="true" DisplayNamePattern="Dell TechHub*" />
      <Application Enabled="true" DisplayNamePattern="Dell Tech Management*" />
      <Application Enabled="true" DisplayNamePattern="Dell Client Device Manager*" />
      <Application Enabled="true" DisplayNamePattern="Dell Client Management*" />
    </PreserveClassicApplications>

    <ClassicApplications>
      <!-- PublisherPattern is an additional safety condition. Remove or adjust it only after the
           manual inventory confirms the publisher used on your factory image. -->
      <Application Enabled="true" DisplayNamePattern="Dell SupportAssist*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="SupportAssist*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="Dell Optimizer*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="Dell Digital Delivery*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="Dell Customer Connect*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="Dell Mobile Connect*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="Dell Pair*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="MyDell*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="My Dell*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="Dell CinemaColor*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="Dell CinemaStream*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="Dell CinemaSound*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="Dell Update*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="Dell Foundation Services*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="Dell Data Vault*" PublisherPattern="Dell*" />
      <Application Enabled="true" DisplayNamePattern="SupportAssist OS Recovery Plugin*" PublisherPattern="Dell*" />

      <!-- Security-suite removal commonly needs vendor cleanup tooling; disabled by default. -->
      <Application Enabled="false" DisplayNamePattern="McAfee*" />
      <Application Enabled="false" DisplayNamePattern="Norton*" />
      <Application Enabled="false" DisplayNamePattern="WildTangent Games App*" />
    </ClassicApplications>

    <PublicDesktopShortcuts>
      <Shortcut Enabled="true" NamePattern="Microsoft Edge.lnk" />
      <Shortcut Enabled="true" NamePattern="Google Chrome.lnk" />
      <Shortcut Enabled="true" NamePattern="SupportAssist*.lnk" />
      <Shortcut Enabled="true" NamePattern="Dell Digital Delivery*.lnk" />
      <Shortcut Enabled="true" NamePattern="Dropbox*.lnk" />
      <Shortcut Enabled="true" NamePattern="Booking*.lnk" />
      <Shortcut Enabled="true" NamePattern="McAfee*.lnk" />
    </PublicDesktopShortcuts>
  </Debloat>

  <PostEnroll
    Enabled="true"
    TaskPath="\EnterpriseAutopilotBranding"
    TaskName="PostEnroll"
    DelayMinutes="2"
    WaitForInteractiveUserSeconds="120"
    MaximumAttempts="5"
    RunOnce="true"
    UnregisterAfterMaximumAttempts="false"
    UiEnabled="true"
    UiTopMost="true"
    UiAllowMove="true"
    ShowCompletionPrompt="true"
    ShowRestartPrompt="true">

    <!-- The task stays registered when one of these accounts signs in. Add deployment technician,
         local break-glass, kiosk, and shared support accounts used in your environment. -->
    <ExcludedUsers>
      <User Enabled="true" Pattern="defaultuser0" />
      <User Enabled="true" Pattern="Administrator" />
      <User Enabled="true" Pattern="WINADMIN" />
      <User Enabled="true" Pattern="WDAGUtilityAccount" />
    </ExcludedUsers>

    <!-- Enabled steps appear in this order. Increment a step's Version whenever its behavior or
         payload changes; previously successful versions are skipped during retries. -->
    <Steps>
      <Step
        Enabled="true"
        Id="Debloat.FirstLogin"
        Version="1.0.0"
        DisplayName="Remove unnecessary applications"
        Handler="Debloat"
        Scope="Device"
        Critical="false"
        TimeoutSeconds="1800" />

      <!-- Recommended AWS layout: keep the AWS client as its own Intune Win32 app. If exact
           first-login sequencing is required, copy your existing AWSVPN_PSADT folder to
           Custom\Payloads and enable this step. The sample script verifies installation. -->
      <Step
        Enabled="false"
        Id="AwsVpn.Install"
        Version="1.0.0"
        DisplayName="Install AWS VPN Client"
        Handler="PowerShell"
        Scope="Device"
        Critical="true"
        TimeoutSeconds="1800"
        Path="Custom\Steps\Install-AwsVpn.ps1" />

      <!-- Optional extension point for additional idempotent organization-specific work. -->
      <Step
        Enabled="false"
        Id="Organization.Custom"
        Version="1.0.0"
        DisplayName="Apply organization settings"
        Handler="PowerShell"
        Scope="Device"
        Critical="true"
        TimeoutSeconds="1800"
        Path="Custom\PostEnroll.Custom.ps1" />
    </Steps>
  </PostEnroll>
</EnterpriseAutopilotBranding>
