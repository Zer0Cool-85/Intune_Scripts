<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:simpleType name="VersionType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+(\.[0-9]+){1,3}" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DebloatModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Audit" />
      <xs:enumeration value="Enforce" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TimeZoneModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Unchanged" />
      <xs:enumeration value="Explicit" />
      <xs:enumeration value="Automatic" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RegistryTypeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="String" />
      <xs:enumeration value="ExpandString" />
      <xs:enumeration value="DWord" />
      <xs:enumeration value="QWord" />
      <xs:enumeration value="MultiString" />
      <xs:enumeration value="Binary" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OnboardingScopeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Device" />
      <xs:enumeration value="User" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OnboardingHandlerType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Debloat" />
      <xs:enumeration value="PowerShell" />
      <xs:enumeration value="WaitForFile" />
      <xs:enumeration value="WaitForApplication" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="EnabledFileType">
    <xs:attribute name="Enabled" type="xs:boolean" use="required" />
    <xs:attribute name="Source" type="xs:string" use="required" />
    <xs:attribute name="Destination" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="RegistryValueType">
    <xs:attribute name="Enabled" type="xs:boolean" use="required" />
    <xs:attribute name="Key" type="xs:string" use="required" />
    <xs:attribute name="Name" type="xs:string" use="required" />
    <xs:attribute name="Type" type="RegistryTypeType" use="required" />
    <xs:attribute name="Data" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="RegistryCollectionType">
    <xs:sequence>
      <xs:element name="Value" type="RegistryValueType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EnabledNameType">
    <xs:attribute name="Enabled" type="xs:boolean" use="required" />
    <xs:attribute name="Name" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="ExcludedUserType">
    <xs:attribute name="Enabled" type="xs:boolean" use="required" />
    <xs:attribute name="Pattern" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="OnboardingStepType">
    <xs:attribute name="Enabled" type="xs:boolean" use="required" />
    <xs:attribute name="Id" type="xs:string" use="required" />
    <xs:attribute name="Version" type="VersionType" use="required" />
    <xs:attribute name="DisplayName" type="xs:string" use="required" />
    <xs:attribute name="Handler" type="OnboardingHandlerType" use="required" />
    <xs:attribute name="Scope" type="OnboardingScopeType" use="required" />
    <xs:attribute name="Critical" type="xs:boolean" use="required" />
    <xs:attribute name="TimeoutSeconds" type="xs:positiveInteger" use="required" />
    <xs:attribute name="Path" type="xs:string" use="optional" />
    <xs:attribute name="Arguments" type="xs:string" use="optional" />
    <xs:attribute name="DetectionPath" type="xs:string" use="optional" />
    <xs:attribute name="DetectionNamePattern" type="xs:string" use="optional" />
  </xs:complexType>

  <xs:complexType name="PackageRuleType">
    <xs:attribute name="Enabled" type="xs:boolean" use="required" />
    <xs:attribute name="NamePattern" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="ClassicRuleType">
    <xs:attribute name="Enabled" type="xs:boolean" use="required" />
    <xs:attribute name="DisplayNamePattern" type="xs:string" use="required" />
    <xs:attribute name="PublisherPattern" type="xs:string" use="optional" />
  </xs:complexType>

  <xs:complexType name="PackageRuleCollectionType">
    <xs:sequence>
      <xs:element name="Package" type="PackageRuleType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ClassicRuleCollectionType">
    <xs:sequence>
      <xs:element name="Application" type="ClassicRuleType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:element name="EnterpriseAutopilotBranding">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Metadata">
          <xs:complexType>
            <xs:attribute name="OrganizationName" type="xs:string" use="required" />
            <xs:attribute name="UpstreamProject" type="xs:string" use="required" />
            <xs:attribute name="UpstreamBaseVersion" type="VersionType" use="required" />
          </xs:complexType>
        </xs:element>

        <xs:element name="Execution">
          <xs:complexType>
            <xs:attribute name="MinimumSupportedBuild" type="xs:positiveInteger" use="required" />
          </xs:complexType>
        </xs:element>

        <xs:element name="Branding">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Wallpaper" type="EnabledFileType" />
              <xs:element name="LockScreen" type="EnabledFileType" />
              <xs:element name="Theme" type="EnabledFileType" />
              <xs:element name="OemLogo" type="EnabledFileType" />
              <xs:element name="TaskbarLayout" type="EnabledFileType" />
              <xs:element name="LegacyStartLayout">
                <xs:complexType>
                  <xs:attribute name="Enabled" type="xs:boolean" use="required" />
                  <xs:attribute name="MinimumBuild" type="xs:positiveInteger" use="required" />
                  <xs:attribute name="MaximumBuild" type="xs:positiveInteger" use="required" />
                  <xs:attribute name="Start2Source" type="xs:string" use="required" />
                  <xs:attribute name="SettingsSource" type="xs:string" use="required" />
                  <xs:attribute name="Start2Destination" type="xs:string" use="required" />
                  <xs:attribute name="SettingsDestination" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="OemInformation">
                <xs:complexType>
                  <xs:attribute name="Enabled" type="xs:boolean" use="required" />
                  <xs:attribute name="Manufacturer" type="xs:string" use="required" />
                  <xs:attribute name="Model" type="xs:string" use="required" />
                  <xs:attribute name="SupportPhone" type="xs:string" use="required" />
                  <xs:attribute name="SupportHours" type="xs:string" use="required" />
                  <xs:attribute name="SupportURL" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="DefaultUserRegistry" type="RegistryCollectionType" />
              <xs:element name="MachineRegistry" type="RegistryCollectionType" />
            </xs:sequence>
            <xs:attribute name="Enabled" type="xs:boolean" use="required" />
          </xs:complexType>
        </xs:element>

        <xs:element name="OsConfiguration">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="TimeZone">
                <xs:complexType>
                  <xs:attribute name="Mode" type="TimeZoneModeType" use="required" />
                  <xs:attribute name="Id" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="DefaultAppAssociations">
                <xs:complexType>
                  <xs:attribute name="Enabled" type="xs:boolean" use="required" />
                  <xs:attribute name="Source" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="WindowsFeatures">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="DisableOptionalFeatures">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Feature" type="EnabledNameType" minOccurs="0" maxOccurs="unbounded" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="RemoveCapabilities">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Capability" type="EnabledNameType" minOccurs="0" maxOccurs="unbounded" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="AddCapabilities">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Capability" type="EnabledNameType" minOccurs="0" maxOccurs="unbounded" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="Enabled" type="xs:boolean" use="required" />
                  <xs:attribute name="TemporarilyBypassWsus" type="xs:boolean" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="Debloat">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="PreserveAppxPackages" type="PackageRuleCollectionType" />
              <xs:element name="AppxPackages" type="PackageRuleCollectionType" />
              <xs:element name="PreserveClassicApplications" type="ClassicRuleCollectionType" />
              <xs:element name="ClassicApplications" type="ClassicRuleCollectionType" />
              <xs:element name="PublicDesktopShortcuts">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Shortcut" type="PackageRuleType" minOccurs="0" maxOccurs="unbounded" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="Enabled" type="xs:boolean" use="required" />
            <xs:attribute name="Mode" type="DebloatModeType" use="required" />
            <xs:attribute name="RunDuringDevicePhase" type="xs:boolean" use="required" />
            <xs:attribute name="RunAtFirstLogon" type="xs:boolean" use="required" />
            <xs:attribute name="RemoveProvisionedPackages" type="xs:boolean" use="required" />
            <xs:attribute name="RemoveInstalledPackages" type="xs:boolean" use="required" />
            <xs:attribute name="RemoveClassicApplications" type="xs:boolean" use="required" />
            <xs:attribute name="RemovePublicDesktopShortcuts" type="xs:boolean" use="required" />
            <xs:attribute name="ClassicUninstallTimeoutSeconds" type="xs:positiveInteger" use="required" />
            <xs:attribute name="ClassicOverallTimeoutSeconds" type="xs:positiveInteger" use="required" />
            <xs:attribute name="FailOnError" type="xs:boolean" use="required" />
          </xs:complexType>
        </xs:element>

        <xs:element name="PostEnroll">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ExcludedUsers">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="User" type="ExcludedUserType" minOccurs="0" maxOccurs="unbounded" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Steps">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Step" type="OnboardingStepType" minOccurs="1" maxOccurs="unbounded" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="Enabled" type="xs:boolean" use="required" />
            <xs:attribute name="TaskPath" type="xs:string" use="required" />
            <xs:attribute name="TaskName" type="xs:string" use="required" />
            <xs:attribute name="DelayMinutes" type="xs:nonNegativeInteger" use="required" />
            <xs:attribute name="WaitForInteractiveUserSeconds" type="xs:nonNegativeInteger" use="required" />
            <xs:attribute name="MaximumAttempts" type="xs:positiveInteger" use="required" />
            <xs:attribute name="RunOnce" type="xs:boolean" use="required" />
            <xs:attribute name="UnregisterAfterMaximumAttempts" type="xs:boolean" use="required" />
            <xs:attribute name="UiEnabled" type="xs:boolean" use="required" />
            <xs:attribute name="UiTopMost" type="xs:boolean" use="required" />
            <xs:attribute name="UiAllowMove" type="xs:boolean" use="required" />
            <xs:attribute name="ShowCompletionPrompt" type="xs:boolean" use="required" />
            <xs:attribute name="ShowRestartPrompt" type="xs:boolean" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="SchemaVersion" type="xs:string" use="required" fixed="2" />
      <xs:attribute name="PackageVersion" type="VersionType" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>
