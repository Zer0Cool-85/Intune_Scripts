<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Setup" Width="900" Height="820" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F6FA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#17243B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DFE6F0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF1FF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16815D"/>
    <SolidColorBrush x:Key="FailureBrush" Color="#C53F4E"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#A86D0B"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#F7F9FC"/>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="StepTemplate">
      <Border x:Name="StepCard" CornerRadius="10" Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8" Padding="16,13">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="28" Height="28" VerticalAlignment="Top" Margin="0,1,12,0">
            <Ellipse x:Name="IconBackground" Fill="{DynamicResource SubtleBrush}"/>
            <TextBlock x:Name="PendingNumber" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
            <Path x:Name="SpinnerIcon" Data="M14,4 A10,10 0 1 1 4,14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
            </Path>
            <Path x:Name="CheckIcon" Data="M7,14 L12,19 L22,8" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
            <Path x:Name="ErrorIcon" Data="M9,9 L19,19 M19,9 L9,19" Stroke="{DynamicResource FailureBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
            <Path x:Name="SkipIcon" Data="M8,14 L20,14" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
          </Grid>
          <StackPanel Grid.Column="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <Border x:Name="BadgeBackground" Background="{DynamicResource SubtleBrush}" CornerRadius="5" Padding="8,3">
                  <TextBlock x:Name="StatusBadge" Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="{Binding Elapsed}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" FontSize="10" Margin="0,5,0,0"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <ProgressBar Height="3" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding Percent}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0" Visibility="{Binding HasPercent, Converter={StaticResource BoolVisibility}}"/>
            <Expander x:Name="ErrorExpander" Header="Technical details" Foreground="{DynamicResource FailureBrush}" FontSize="11" Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
              <TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="8" Margin="0,5,0,0" Background="{DynamicResource SubtleBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11"/>
            </Expander>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Running">
          <Setter TargetName="StepCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
          <Setter TargetName="IconBackground" Property="Fill" Value="{DynamicResource AccentSoftBrush}"/>
          <Setter TargetName="BadgeBackground" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
          <Setter TargetName="StatusBadge" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
          <Setter TargetName="PendingNumber" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="SpinnerIcon" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Running"/><Condition Binding="{Binding Animated}" Value="True"/></MultiDataTrigger.Conditions>
          <MultiDataTrigger.EnterActions>
            <BeginStoryboard x:Name="SpinStoryboard"><Storyboard><DoubleAnimation Storyboard.TargetName="SpinnerIcon" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard>
          </MultiDataTrigger.EnterActions>
          <MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="SpinStoryboard"/></MultiDataTrigger.ExitActions>
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Complete"><Setter TargetName="PendingNumber" Property="Visibility" Value="Collapsed"/><Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/><Setter TargetName="StatusBadge" Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="AlreadyComplete"><Setter TargetName="PendingNumber" Property="Visibility" Value="Collapsed"/><Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/><Setter TargetName="StatusBadge" Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter TargetName="PendingNumber" Property="Visibility" Value="Collapsed"/><Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible"/><Setter TargetName="StatusBadge" Property="Foreground" Value="{DynamicResource FailureBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Skipped"><Setter TargetName="PendingNumber" Property="Visibility" Value="Collapsed"/><Setter TargetName="SkipIcon" Property="Visibility" Value="Visible"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="BannerContainer" Height="120" Visibility="Collapsed" Background="{DynamicResource AccentBrush}"><Image x:Name="BannerImage" Stretch="UniformToFill"/></Border>
    <Grid Grid.Row="1" Margin="28,22,28,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <Grid Margin="0,0,0,17">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image x:Name="LogoImage" MaxWidth="170" MaxHeight="48" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,12,0" Visibility="Collapsed"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="CompanyLabel" Text="YOUR COMPANY" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="DEVICE SETUP" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
          <Border x:Name="DemoBadge" Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="DEMO PREVIEW" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/></Border>
        </Grid>
        <TextBlock x:Name="WelcomeHeading" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" Text="Welcome to your new PC"/>
        <TextBlock x:Name="WelcomeMessage" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,0" Text="Please wait while we finish device setup."/>
      </StackPanel>
      <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,18,0,14">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="OverallHeading" Text="Getting things ready" FontWeight="SemiBold"/>
            <TextBlock x:Name="ProgressCount" Grid.Column="1" Text="0 of 5 steps finished" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
          <ProgressBar x:Name="OverallProgress" Height="5" Minimum="0" Maximum="100" Margin="0,11,0,10" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0"/>
          <TextBlock x:Name="OverallMessage" Text="Your settings and applications are being prepared." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="StepScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <ItemsControl x:Name="StepList" ItemTemplate="{StaticResource StepTemplate}"/>
      </ScrollViewer>
      <StackPanel Grid.Row="3" Margin="0,12,0,0">
        <TextBlock x:Name="RebootMessage" Text="A restart is required to finish applying changes. Save your work and restart when convenient." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="FooterText" Text="Keep your device plugged in and connected." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
            <TextBlock x:Name="SupportText" Text="Need help? Contact your IT service desk." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
            <TextBlock x:Name="ElapsedText" Text="Elapsed 00:00" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
          </StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="310" HorizontalAlignment="Right">
            <Button x:Name="RetryButton" Content="Retry unfinished" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="CloseButton" Content="Done" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="White" IsEnabled="False"/>
          </WrapPanel>
        </Grid>
        <Expander x:Name="DiagnosticsExpander" Header="Setup details" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,10,0,0">
          <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="DiagnosticText" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="65" VerticalScrollBarVisibility="Auto" FontSize="10"/>
            <Button x:Name="CopyButton" Grid.Column="1" Content="Copy details" Padding="10,5" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </Grid>
        </Expander>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
